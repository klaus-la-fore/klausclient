package com.donutsmp.bypass;

import net.fabricmc.api.ModInitializer;
import net.minecraft.client.network.ClientPlayNetworkHandler;
import net.minecraft.network.packet.c2s.play.KeepAliveC2SPacket;
import net.minecraft.network.packet.s2c.play.KeepAliveS2CPacket;
import java.util.Random;

public class DonutSMPClient implements ModInitializer {
    public static final Random RND = new Random();

    @Override
    public void onInitialize() {

    }


    public static void handleKeepAlive(KeepAliveS2CPacket packet, ClientPlayNetworkHandler handler) {
        handler.sendPacket(new KeepAliveC2SPacket(packet.getId()));
    }


    public static float getDynamicReach() { return 3.0f + (RND.nextFloat() * 0.5f); }


    public static int getAuraDelay() { return 50 + RND.nextInt(30); }


    public static double getVelocityModifier() { return 0.15; }
}
